{
  "name": "js-reactivity-benchmark",
  "version": "1.0.0",
  "description": "Correctness-checked JavaScript reactive graph benchmarks",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "run": "node --expose-gc dist/index.js",
    "bench": "pnpm build && pnpm run run",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:cli",
    "test:cli": "node scripts/check-cli.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@amadeus-it-group/tansu": "^2.0.0",
    "@angular/core": "22.1.7",
    "@vue/reactivity": "^3.5.43",
    "alien-signals": "3.2.1",
    "mobx": "^7.0.3",
    "mol_wire_lib": "^1.0.1781",
    "oby": "15.1.2",
    "random": "^5.5.1",
    "signal-polyfill": "^0.2.2",
    "solid-js": "^1.9.15",
    "svelte": "5.57.0",
    "usignal": "^0.10.0",
    "@preact/signals-core": "1.14.4",
    "@tldraw/state": "5.4.2",
    "@legendapp/state": "2.1.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "prettier": "^3.9.8",
    "vitest": "^5.0.1",
    "vite": "8.3.0",
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  }
}
